# If true, connect to TEST_PODMAN_URI below instead of starting Podman instances with Testcontainers
USE_EXTERNAL_PODMAN=true

# External Podman API addresses, comma-separated. Only tcp:// and unix:// are supported
# Each address is one pool slot, so N addresses run up to N test classes concurrently
# External daemons are never reset between test classes
TEST_PODMAN_URI=tcp://127.0.0.1:8080
#TEST_PODMAN_URI=unix:///run/user/1000/podman/podman.sock
#TEST_PODMAN_URI=tcp://127.0.0.1:8080,tcp://127.0.0.1:8081

# Podman image started by Testcontainers when USE_EXTERNAL_PODMAN is false
#PODMAN_IMAGE=quay.io/podman/stable:v5.8.7
